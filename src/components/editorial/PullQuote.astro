---
// src/components/editorial/PullQuote.astro
interface Props {
  quote: string;
  attribution: string;
  role?: string; // e.g. "Private Client • Country Estate Wedding"
  publication?: string; // e.g. "British Vogue Weddings"
  layout?: 'centered' | 'statement';
  class?: string;
}

const {
  quote,
  attribution,
  role,
  publication,
  layout = 'centered',
  class: className = ''
} = Astro.props;

const isCentered = layout === 'centered';
---

<section class={`editorial-pull-quote py-20 md:py-28 bg-[#0a0a0a] border-y border-white/10 relative overflow-hidden ${className}`}>
  <!-- Subtle decorative ambient gold glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-gold/5 blur-[120px] rounded-full pointer-events-none"></div>

  <div class={`max-w-4xl mx-auto px-6 lg:px-12 relative z-10 ${isCentered ? 'text-center' : 'text-left pl-8 md:pl-12 border-l border-gold/40'}`}>
    
    <!-- Stylised Editorial Quotation Mark -->
    {isCentered && (
      <div class="reveal-on-scroll font-display text-6xl md:text-7xl text-gold/40 leading-none select-none mb-2 font-serif">
        “
      </div>
    )}

    <!-- The Quote Body -->
    <blockquote class={`reveal-on-scroll delay-100 font-display text-2xl sm:text-3xl md:text-4xl lg:text-[2.6rem] font-light text-cream italic leading-[1.3] mb-8 ${isCentered ? '' : 'not-italic font-normal'}`}>
      {!isCentered && <span class="text-gold font-serif mr-1">“</span>}
      {quote}
      {!isCentered && <span class="text-gold font-serif ml-1">”</span>}
    </blockquote>

    <!-- Attribution Block -->
    <div class="reveal-on-scroll delay-200 space-y-2">
      <div class="font-body text-xs uppercase tracking-[0.22em] text-cream font-medium">
        {attribution}
      </div>
      
      {(role || publication) && (
        <div class="text-[11px] font-body uppercase tracking-luxury text-stone">
          {role}
          {role && publication && <span class="mx-2 text-stone/40">•</span>}
          {publication && <span class="text-gold/90">{publication}</span>}
        </div>
      )}
    </div>

  </div>
</section>
