---
// src/components/editorial/EditorialHero.astro
import { Image } from 'astro:assets';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image?: any; // ImageMetadata or string path
  imageAlt?: string;
  caption?: string; // Magazine-style caption: "Project • Venue • Season"
  variant?: 'full-bleed' | 'split';
  primaryCtaText?: string;
  primaryCtaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  minHeight?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  image = "/images/hero.jpg",
  imageAlt = "SB Floristry Architectural Installation",
  caption,
  variant = 'full-bleed',
  primaryCtaText,
  primaryCtaHref = '/enquire/',
  secondaryCtaText,
  secondaryCtaHref = '/portfolio/',
  minHeight = 'min-h-[90vh]'
} = Astro.props;

const isAsset = typeof image === 'object' && image !== null && 'src' in image;
---

{variant === 'full-bleed' && (
  <section class={`relative ${minHeight} flex items-center justify-center overflow-hidden bg-obsidian text-cream`}>
    <!-- Background Image with Cinematic Vignettes -->
    <div class="absolute inset-0">
      {isAsset ? (
        <Image
          src={image}
          alt={imageAlt}
          class="w-full h-full object-cover hero-zoom opacity-70"
          loading="eager"
        />
      ) : (
        <img
          src={image}
          alt={imageAlt}
          class="w-full h-full object-cover hero-zoom opacity-70"
          loading="eager"
        />
      )}
      <!-- Deep Obsidian Vignette & Atmospheric Gradients -->
      <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-obsidian/40 to-obsidian/75"></div>
      <div class="absolute inset-0 bg-radial-vignette opacity-60"></div>
    </div>

    <!-- Hero Content -->
    <div class="relative z-10 max-w-5xl mx-auto px-6 lg:px-12 text-center pt-24 pb-20">
      {eyebrow && (
        <div class="reveal-on-scroll">
          <span class="inline-block text-[11px] md:text-xs font-body uppercase tracking-[0.28em] text-gold font-medium mb-6">
            {eyebrow}
          </span>
        </div>
      )}

      <h1 class="reveal-on-scroll delay-100 font-display text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-light tracking-tight text-cream mb-6 leading-[1.08]">
        {title}
      </h1>

      {subtitle && (
        <p class="reveal-on-scroll delay-200 font-display text-lg sm:text-xl md:text-2xl font-light italic text-stone max-w-2xl mx-auto leading-relaxed mb-10">
          {subtitle}
        </p>
      )}

      {(primaryCtaText || secondaryCtaText) && (
        <div class="reveal-on-scroll delay-300 flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 pt-2">
          {primaryCtaText && (
            <a href={primaryCtaHref} class="btn-solid-gold w-full sm:w-auto">
              {primaryCtaText}
            </a>
          )}
          {secondaryCtaText && (
            <a href={secondaryCtaHref} class="btn-outline-luxury w-full sm:w-auto">
              {secondaryCtaText}
            </a>
          )}
        </div>
      )}
    </div>

    <!-- Editorial Magazine Caption (Bottom Edge) -->
    {caption && (
      <div class="absolute bottom-6 left-6 right-6 lg:left-12 lg:right-12 hidden sm:flex justify-between items-center text-[10px] font-body uppercase tracking-luxury text-stone/80 border-t border-white/10 pt-3 z-10">
        <span>{caption}</span>
        <span class="text-gold/80">London & Essex Atelier</span>
      </div>
    )}
  </section>
)}

{variant === 'split' && (
  <section class="relative bg-obsidian text-cream border-b border-white/10 pt-16 md:pt-24 pb-20 md:pb-28 overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Text Column (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
          {eyebrow && (
            <div class="reveal-on-scroll">
              <span class="text-[11px] font-body uppercase tracking-[0.25em] text-gold font-medium">
                {eyebrow}
              </span>
            </div>
          )}

          <h1 class="reveal-on-scroll delay-100 font-display text-4xl sm:text-5xl lg:text-6xl font-light text-cream leading-[1.1]">
            {title}
          </h1>

          {subtitle && (
            <p class="reveal-on-scroll delay-200 font-display text-xl text-stone italic font-light leading-relaxed">
              {subtitle}
            </p>
          )}

          <slot name="intro" />

          {(primaryCtaText || secondaryCtaText) && (
            <div class="reveal-on-scroll delay-300 flex flex-wrap gap-4 pt-4">
              {primaryCtaText && (
                <a href={primaryCtaHref} class="btn-solid-gold">
                  {primaryCtaText}
                </a>
              )}
              {secondaryCtaText && (
                <a href={secondaryCtaHref} class="btn-outline-luxury">
                  {secondaryCtaText}
                </a>
              )}
            </div>
          )}
        </div>

        <!-- Framed Image Column (7 cols) -->
        <div class="lg:col-span-7">
          <div class="reveal-clip relative aspect-[16/11] md:aspect-[16/10] bg-[#121212] overflow-hidden border border-white/10 shadow-2xl">
            {isAsset ? (
              <Image
                src={image}
                alt={imageAlt}
                class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
                loading="eager"
              />
            ) : (
              <img
                src={image}
                alt={imageAlt}
                class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
                loading="eager"
              />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-obsidian/60 via-transparent to-transparent"></div>
          </div>
          {caption && (
            <p class="text-[10px] font-body uppercase tracking-luxury text-stone mt-3 pl-1">
              {caption}
            </p>
          )}
        </div>

      </div>
    </div>
  </section>
)}
