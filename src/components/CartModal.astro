---
import deliveryConfig from '../config/delivery.json';

// Helper to format price in frontend
const formatPrice = (amount) => {
  return new Intl.NumberFormat('en-GB', {
    style: 'currency',
    currency: 'GBP',
  }).format(amount);
};
---

<!-- Cart Drawer -->
<div id="cart-modal" class="relative z-50 hidden" aria-labelledby="slide-over-title" role="dialog" aria-modal="true">
  <!-- Background backdrop, show/hide based on slide-over state. -->
  <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" id="cart-backdrop"></div>

  <div class="fixed inset-0 overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
      <div class="pointer-events-none fixed inset-y-0 right-0 flex max-w-full pl-10">
        <div class="pointer-events-auto w-screen max-w-md">
          <div class="flex h-full flex-col overflow-y-scroll bg-white shadow-xl">
            <div class="flex-1 overflow-y-auto px-4 py-6 sm:px-6">
              <div class="flex items-start justify-between">
                <h2 class="text-lg font-medium text-gray-900" id="slide-over-title">Shopping Basket</h2>
                <div class="ml-3 flex h-7 items-center">
                  <button type="button" class="relative -m-2 p-2 text-gray-400 hover:text-gray-500" id="close-cart-btn">
                    <span class="absolute -inset-0.5"></span>
                    <span class="sr-only">Close panel</span>
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  </button>
                </div>
              </div>

              <div class="mt-8">
                <div class="flow-root">
                  <ul role="list" class="-my-6 divide-y divide-gray-200" id="cart-items-list">
                    <!-- Dynamic Cart Items -->
                  </ul>
                </div>
              </div>
            </div>

            <!-- Cart Footer -->
            <div class="border-t border-gray-200 px-4 py-6 sm:px-6 bg-gray-50">
              <!-- Delivery Options -->
              <div class="mb-4">
                <label for="delivery-type" class="block text-sm font-medium text-gray-700">Delivery Method</label>
                <select id="delivery-type" class="mt-1 block w-full rounded-md border-gray-300 py-2 pl-3 pr-10 text-base focus:border-primary focus:outline-none focus:ring-primary sm:text-sm">
                  <option value="collection">Store Collection (Free)</option>
                  <option value="local">Local Delivery ({formatPrice(deliveryConfig.localDeliveryCharge)})</option>
                </select>
              </div>

              <!-- Postcode validation for local delivery -->
              <div id="postcode-section" class="hidden mb-4">
                <label for="delivery-postcode" class="block text-sm font-medium text-gray-700">Delivery Postcode</label>
                <div class="mt-1 flex gap-2">
                  <input type="text" id="delivery-postcode" placeholder="e.g. RM1 1QA" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm" />
                  <button type="button" id="validate-postcode-btn" class="inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50">
                    Verify
                  </button>
                </div>
                <p id="postcode-feedback" class="mt-1 text-sm"></p>
              </div>

              <div class="flex justify-between text-base font-medium text-gray-900">
                <p>Subtotal</p>
                <p id="cart-subtotal">£0.00</p>
              </div>
              <div class="flex justify-between text-sm text-gray-500 mt-1">
                <p>Delivery</p>
                <p id="cart-delivery-cost">£0.00</p>
              </div>
              <div class="flex justify-between text-base font-bold text-gray-900 mt-2 border-t border-gray-200 pt-2">
                <p>Total</p>
                <p id="cart-total">£0.00</p>
              </div>

              <p class="mt-0.5 text-sm text-gray-500">Shipping and taxes calculated at checkout.</p>
              <div class="mt-6">
                <button id="checkout-btn" class="flex w-full items-center justify-center rounded-md border border-transparent bg-primary px-6 py-3 text-base font-medium text-white shadow-sm hover:bg-primary-dark transition-colors duration-200">
                  Checkout
                </button>
              </div>
              <div class="mt-6 flex justify-center text-center text-sm text-gray-500">
                <p>
                  or{' '}
                  <button type="button" class="font-medium text-primary hover:text-primary-dark" id="keep-shopping-btn">
                    Continue Shopping
                    <span aria-hidden="true"> &rarr;</span>
                  </button>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import deliveryConfig from '../config/delivery.json';

  let cart = [];
  let isCartOpen = false;
  let deliveryType = 'collection'; // 'collection' or 'local'
  let deliveryCost = 0;
  let isPostcodeValid = false;

  // Selectors
  const cartModal = document.getElementById('cart-modal');
  const cartBackdrop = document.getElementById('cart-backdrop');
  const closeCartBtn = document.getElementById('close-cart-btn');
  const keepShoppingBtn = document.getElementById('keep-shopping-btn');
  const cartItemsList = document.getElementById('cart-items-list');
  const cartSubtotalEl = document.getElementById('cart-subtotal');
  const cartDeliveryCostEl = document.getElementById('cart-delivery-cost');
  const cartTotalEl = document.getElementById('cart-total');
  const deliveryTypeSelect = document.getElementById('delivery-type') as HTMLSelectElement;
  const postcodeSection = document.getElementById('postcode-section');
  const deliveryPostcodeEl = document.getElementById('delivery-postcode') as HTMLInputElement;
  const validatePostcodeBtn = document.getElementById('validate-postcode-btn');
  const postcodeFeedbackEl = document.getElementById('postcode-feedback');
  const checkoutBtn = document.getElementById('checkout-btn');

  // Load cart from localStorage
  function loadCart() {
    const savedCart = localStorage.getItem('cart');
    if (savedCart) {
      cart = JSON.parse(savedCart);
    }
    updateCartUI();
  }

  // Save cart to localStorage
  function saveCart() {
    localStorage.setItem('cart', JSON.stringify(cart));
    updateCartUI();
  }

  // Format price helper
  const formatPrice = (amount) => {
    return new Intl.NumberFormat('en-GB', {
      style: 'currency',
      currency: 'GBP',
    }).format(amount);
  };

  // Toggle cart drawer
  function toggleCart(show) {
    isCartOpen = show;
    if (show) {
      cartModal.classList.remove('hidden');
    } else {
      cartModal.classList.add('hidden');
    }
  }

  // Add item to cart
  function addToCart(item) {
    const itemKey = item.variantId || item.id;
    const existingItemIndex = cart.findIndex((i) => (i.variantId || i.id) === itemKey);
    
    if (existingItemIndex > -1) {
      cart[existingItemIndex].quantity += 1;
    } else {
      cart.push(item);
    }
    saveCart();
    toggleCart(true);
  }

  // Update item quantity
  function updateQuantity(id, change) {
    const itemIndex = cart.findIndex((i) => (i.variantId || i.id) === id);
    if (itemIndex > -1) {
      cart[itemIndex].quantity += change;
      if (cart[itemIndex].quantity <= 0) {
        cart.splice(itemIndex, 1);
      }
      saveCart();
    }
  }

  // Remove item from cart
  function removeItem(id) {
    cart = cart.filter((i) => (i.variantId || i.id) !== id);
    saveCart();
  }

  // Validate postcode
  function validatePostcode() {
    if (!deliveryPostcodeEl) return;
    const postcode = deliveryPostcodeEl.value.trim().toUpperCase().replace(/\s+/g, '');
    
    if (!postcode) {
      showPostcodeFeedback('Please enter a postcode.', 'error');
      isPostcodeValid = false;
      return;
    }

    // Check against allowed local postcodes
    const allowedPrefixes = deliveryConfig.allowedPostcodes.map(p => p.toUpperCase());
    const isValid = allowedPrefixes.some(prefix => postcode.startsWith(prefix));

    if (isValid) {
      showPostcodeFeedback('Delivery is available for this postcode!', 'success');
      isPostcodeValid = true;
      deliveryCost = deliveryConfig.localDeliveryCharge;
    } else {
      showPostcodeFeedback('Sorry, we only deliver to Romford and surrounding areas (RM postcodes).', 'error');
      isPostcodeValid = false;
      deliveryCost = 0;
    }
    updateCartTotals();
  }

  function showPostcodeFeedback(message, type) {
    if (!postcodeFeedbackEl) return;
    postcodeFeedbackEl.textContent = message;
    if (type === 'success') {
      postcodeFeedbackEl.className = 'mt-1 text-sm text-green-600';
    } else {
      postcodeFeedbackEl.className = 'mt-1 text-sm text-red-600';
    }
  }

  // Calculate and update totals
  function updateCartTotals() {
    const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    
    if (deliveryType === 'collection') {
      deliveryCost = 0;
    } else if (deliveryType === 'local') {
      deliveryCost = isPostcodeValid ? deliveryConfig.localDeliveryCharge : 0;
    }

    const total = subtotal + deliveryCost;

    if (cartSubtotalEl) cartSubtotalEl.textContent = formatPrice(subtotal);
    if (cartDeliveryCostEl) cartDeliveryCostEl.textContent = formatPrice(deliveryCost);
    if (cartTotalEl) cartTotalEl.textContent = formatPrice(total);

    // Update Header Basket count
    const headerCartCounts = document.querySelectorAll('.cart-count');
    const totalItemsCount = cart.reduce((sum, item) => sum + item.quantity, 0);
    headerCartCounts.forEach(el => {
      el.textContent = totalItemsCount.toString();
      if (totalItemsCount > 0) {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    });
  }

  // Render cart items
  function updateCartUI() {
    if (!cartItemsList) return;
    
    if (cart.length === 0) {
      cartItemsList.innerHTML = `
        <div class="text-center py-12">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <p class="mt-4 text-gray-500 font-medium">Your basket is empty</p>
        </div>
      `;
      updateCartTotals();
      return;
    }

    cartItemsList.innerHTML = cart.map((item) => {
      const itemKey = item.variantId || item.id;
      return `
        <li class="flex py-6">
          <div class="h-24 w-24 flex-shrink-0 overflow-hidden rounded-md border border-gray-200">
            <img src="${item.image}" alt="${item.title}" class="h-full w-full object-cover object-center" />
          </div>
          <div class="ml-4 flex flex-1 flex-col">
            <div>
              <div class="flex justify-between text-base font-medium text-gray-900">
                <h3>
                  <a href="#">${item.title}</a>
                </h3>
                <p class="ml-4">${formatPrice(item.price * item.quantity)}</p>
              </div>
              ${item.variantTitle && item.variantTitle !== 'Default Title' ? `
                <p class="mt-1 text-xs text-gray-500 italic">Size: ${item.variantTitle}</p>
              ` : ''}
            </div>
            <div class="flex flex-1 items-end justify-between text-sm">
              <div class="flex items-center border border-gray-300 rounded-md">
                <button type="button" class="px-2 py-1 text-gray-500 hover:text-gray-700 decrease-qty-btn" data-id="${itemKey}">-</button>
                <span class="px-2 text-gray-900">${item.quantity}</span>
                <button type="button" class="px-2 py-1 text-gray-500 hover:text-gray-700 increase-qty-btn" data-id="${itemKey}">+</button>
              </div>
              <div class="flex">
                <button type="button" class="font-medium text-primary hover:text-primary-dark remove-item-btn" data-id="${itemKey}">Remove</button>
              </div>
            </div>
          </div>
        </li>
      `;
    }).join('');

    // Reattach listeners
    document.querySelectorAll('.decrease-qty-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.target as HTMLElement).dataset.id;
        updateQuantity(id, -1);
      });
    });

    document.querySelectorAll('.increase-qty-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.target as HTMLElement).dataset.id;
        updateQuantity(id, 1);
      });
    });

    document.querySelectorAll('.remove-item-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.target as HTMLElement).dataset.id;
        removeItem(id);
      });
    });

    updateCartTotals();
  }

  // Event Listeners
  if (closeCartBtn) closeCartBtn.addEventListener('click', () => toggleCart(false));
  if (keepShoppingBtn) keepShoppingBtn.addEventListener('click', () => toggleCart(false));
  if (cartBackdrop) cartBackdrop.addEventListener('click', () => toggleCart(false));

  // Listen for open-cart global event
  window.addEventListener('open-cart', () => toggleCart(true));

  // Listen for add-to-cart global event
  window.addEventListener('add-to-cart', (e: CustomEvent) => {
    addToCart(e.detail);
  });

  // Handle Delivery Type Select
  if (deliveryTypeSelect) {
    deliveryTypeSelect.addEventListener('change', (e) => {
      deliveryType = (e.target as HTMLSelectElement).value;
      if (deliveryType === 'local') {
        postcodeSection?.classList.remove('hidden');
      } else {
        postcodeSection?.classList.add('hidden');
      }
      updateCartTotals();
    });
  }

  // Handle Postcode validation
  if (validatePostcodeBtn) {
    validatePostcodeBtn.addEventListener('click', validatePostcode);
  }
  if (deliveryPostcodeEl) {
    deliveryPostcodeEl.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') validatePostcode();
    });
  }

  // Handle checkout
  if (checkoutBtn) {
    checkoutBtn.addEventListener('click', async () => {
      if (cart.length === 0) return;

      if (deliveryType === 'local' && !isPostcodeValid) {
        showPostcodeFeedback('Please verify your postcode for delivery first.', 'error');
        deliveryPostcodeEl?.focus();
        return;
      }

      try {
        checkoutBtn.textContent = 'Processing...';
        checkoutBtn.setAttribute('disabled', 'true');

        const response = await fetch('/api/gocardless/create-checkout', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            items: cart,
            deliveryType,
            deliveryCost,
            postcode: deliveryType === 'local' ? deliveryPostcodeEl?.value : '',
          }),
        });

        const data = await response.json();
        if (data.url) {
          window.location.href = data.url;
        } else {
          alert('Something went wrong. Please try again.');
          checkoutBtn.textContent = 'Checkout';
          checkoutBtn.removeAttribute('disabled');
        }
      } catch (error) {
        console.error('Checkout error:', error);
        alert('Something went wrong. Please try again.');
        checkoutBtn.textContent = 'Checkout';
        checkoutBtn.removeAttribute('disabled');
      }
    });
  }

  // Initial load
  loadCart();
</script>
