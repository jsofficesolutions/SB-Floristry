---
// src/pages/weddings.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialHero from '../components/editorial/EditorialHero.astro';
import Chapter from '../components/editorial/Chapter.astro';
import ImageText from '../components/editorial/ImageText.astro';
import PressStrip from '../components/editorial/PressStrip.astro';
import PullQuote from '../components/editorial/PullQuote.astro';
import InvestmentNote from '../components/editorial/InvestmentNote.astro';
import EnquireCTA from '../components/editorial/EnquireCTA.astro';

const disciplines = [
  {
    title: "Bridal Architecture & Personals",
    subtitle: "Bouquets & Boutonnieres",
    description: "Flowing organic bouquets hand-tied with raw plant-dyed silk ribbons, matching lapel boutonnieres, and delicate botanical hairpins crafted with seasonal floral jewels.",
    image: "/images/hero.jpg"
  },
  {
    title: "The Ceremony & Meadow Aisles",
    subtitle: "Sacred Spatial Statements",
    description: "Freestanding organic arches, deconstructed floral meadows rising from stone flagstones, and grand pedestal arrangements that frame the exchange of vows.",
    image: "/images/collection-weddings.jpg"
  },
  {
    title: "The Banqueting Tablescape",
    subtitle: "Sensory Dining Ensembles",
    description: "Low, conversational arrangements in artisan ceramics, footed compotes, and custom glassware, layered with organic beeswax tapers and scattered garden petals.",
    image: "/images/gallery-2.jpg"
  }
];
---

<BaseLayout
  title="Luxury Wedding Floristry Essex & London | SB Floristry"
  description="Bespoke luxury wedding floristry across Essex, London, and private estates. From intimate ceremonies to breathtaking ballroom installations."
  canonical="https://www.sbfloristry.co.uk/weddings/"
>
  <!-- Full-Bleed Editorial Hero -->
  <EditorialHero
    variant="full-bleed"
    eyebrow="Weddings & Private Estates"
    title="Botanical Grandeur for Your Wedding Day"
    subtitle="Conceived with architectural proportion and organic delicacy. We transform country manors, marquee grounds, and London ballrooms into living sensorial atmospheres."
    image="/images/weddings-bg.jpg"
    imageAlt="Luxury Estate Wedding Floral Architecture"
    caption="Hedsor House • Summer Estate Celebration • SB Floristry"
    primaryCtaText="Commission Your Wedding →"
    primaryCtaHref="/enquire/"
    secondaryCtaText="Explore Portfolio"
    secondaryCtaHref="/portfolio/"
  />

  <PressStrip />

  <!-- The Wedding Experience Chapter -->
  <section class="py-20 md:py-28 bg-obsidian text-cream">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <Chapter
        number="I"
        eyebrow="The Disciplines"
        title="From First Glance to Midnight Waltz"
        subtitle="We design weddings as continuous spatial narratives, ensuring each chapter of your day reveals a fresh botanical wonder."
      />

      <!-- 3 Disciplines Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-16">
        {disciplines.map((item, i) => (
          <div class="reveal-on-scroll bg-[#0c0c0c] border border-white/10 p-8 flex flex-col justify-between group shadow-xl" style={`transition-delay: ${i * 120}ms`}>
            <div>
              <div class="reveal-clip aspect-[4/5] overflow-hidden bg-[#141414] mb-6 border border-white/10">
                <img
                  src={item.image}
                  alt={item.title}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                />
              </div>
              <span class="text-[10px] font-body uppercase tracking-[0.22em] text-gold block mb-2 font-medium">
                {item.subtitle}
              </span>
              <h3 class="font-display text-2xl text-cream font-light mb-3">
                {item.title}
              </h3>
              <p class="font-body text-xs sm:text-sm text-stone leading-relaxed font-light">
                {item.description}
              </p>
            </div>
            <div class="pt-6">
              <a href="/enquire/" class="inline-flex items-center text-xs uppercase tracking-[0.18em] text-gold hover:text-champagne transition-colors group-hover:translate-x-1 duration-200">
                Commission Design →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Editorial Narrative Splits -->
  <div class="space-y-4 md:space-y-8 bg-noir border-y border-white/10">
    
    <ImageText
      split="7-5"
      image="/images/collection-weddings.jpg"
      imageAlt="Estate Ceremony Arch"
      caption="Private Estate Orangery • High Summer"
      chapterNumber="II"
      eyebrow="Spatial Harmony"
      title="The Living Ceremony Arch"
      lead="Organic, foam-free floral installations that appear to have grown naturally from the venue's historical masonry."
      text="We study the natural trajectory of natural daylight, stone textures, and guest perspective lines to position ceremony arches that frame the vow exchange with breath-taking theatricality."
      ctaText="View Ceremony Portfolio →"
      ctaHref="/portfolio/"
    />

    <ImageText
      split="5-7"
      reversed={true}
      image="/images/gallery-2.jpg"
      imageAlt="Wedding Feast Tablescape"
      caption="Candlelit Banquet • Mayfair Ballroom"
      chapterNumber="III"
      eyebrow="The Celebration"
      title="The Twilight Banquet"
      lead="Intimate dining tablescapes layered with fragrant garden blooms, fluted glass, and slow-burning beeswax tapers."
      text="We treat dining tables as tactile landscapes. Low, sprawling floral vessels allow guests to engage across the table while basking in gentle perfume and the warmth of candlelight."
      ctaText="Discuss Your Tablescape →"
      ctaHref="/enquire/"
    />

  </div>

  <!-- Editorial Pull Quote -->
  <PullQuote
    quote="Our guests are still speaking about the floral installations months after our wedding. The scent in the chapel when the doors opened was an unforgettable dream."
    attribution="Victoria & James"
    role="Hedsor House Wedding"
    publication="British Vogue Feature"
  />

  <!-- Investment Transparency -->
  <InvestmentNote
    startingFrom="£3,500"
    service="Bespoke Wedding Commissions"
    title="Seasonal Wedding Allocations"
    note="To guarantee that both studio founders are on-site for site visits, mockups, and live installation, we commit to an exclusive, limited number of weddings per calendar year."
    inclusions={[
      "Initial concept moodboard & private botanical tasting",
      "Full on-site architectural reconnaissance & technical survey",
      "Sustainably harvested British & rare European stem selection",
      "Full morning installation, ceremony transition & midnight teardown"
    ]}
    ctaText="Reserve Your Date →"
    ctaHref="/enquire/"
  />

  <!-- Shared Closing CTA -->
  <EnquireCTA
    eyebrow="Wedding Diary"
    title="Let Us Frame Your Celebration"
    subtitle="Dates for the upcoming season are currently open. We recommend contacting our studio 6 to 12 months in advance of your celebration."
    ctaText="Inquire About Your Date →"
    ctaHref="/enquire/"
  />
</BaseLayout>
