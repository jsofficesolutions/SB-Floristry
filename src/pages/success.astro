---
import Layout from '../layouts/Layout.astro';

// Grabbing checkout parameters for instant personalization
const url = new URL(Astro.request.url);
const customerName = url.searchParams.get('name') || 'Jordan';
const planName = url.searchParams.get('plan') || 'Developer Test Tier';
---

<Layout title="Thank You | SB Floristry">
  <main class="min-h-screen bg-[#FBFBFA] flex flex-col items-center justify-center px-4 py-16 font-sans">
    
    <!-- Outer Content Wrapper -->
    <div class="max-w-2xl w-full text-center">
      
      <!-- Premium Hero Header -->
      <h1 class="text-sb-black font-serif text-5xl md:text-6xl tracking-wide mb-3">
        Thank you,
      </h1>
      <h2 class="text-sb-gold font-serif italic text-4xl md:text-5xl tracking-normal mb-8">
        {customerName}
      </h2>
      
      <p class="text-neutral-700 text-base md:text-lg max-w-lg mx-auto leading-relaxed font-light mb-12 px-2">
        Your Direct Debit mandate for <span class="font-semibold text-sb-black">{planName}</span> has 
        been successfully set up. Every delivery is hand-tied by us personally and styled with pure botanical dedication.[cite: 1]
      </p>

      <!-- Steps & Email Notification Card Container -->
      <div class="bg-white border border-neutral-100 p-6 md:p-10 shadow-sm text-left relative rounded-sm">
        <!-- Luxury Top Border Accent Line -->
        <div class="absolute top-0 left-6 right-6 h-[2px] bg-sb-gold"></div>
        
        <h3 class="text-xs uppercase tracking-luxury font-bold text-sb-gold mb-8">
          What Happens Next?[cite: 1]
        </h3>
        
        <ul class="space-y-8">
          <!-- Step 1: Immediate Order Placement & Email Timeline -->
          <li class="flex items-start gap-4">
            <span class="w-6 h-6 rounded-full bg-sb-cream text-sb-gold text-xs flex items-center justify-center font-semibold shrink-0 mt-0.5">
              1
            </span>
            <div class="w-full">
              <h4 class="font-bold text-sb-black text-xs uppercase tracking-wider mb-1.5">
                Order Placement & Validation[cite: 1]
              </h4>
              <p class="text-sm text-neutral-600 leading-relaxed mb-4">
                Your first order has been placed immediately[cite: 1]. Your bank will now finalize and register the Direct Debit mandate for future billing cycles (usually takes 2–3 business days)[cite: 1]. No action is required from you[cite: 1].
              </p>
              
              <!-- Sequential Email Timeline Box -->
              <div class="bg-sb-cream/40 border border-sb-gold/20 p-4 space-y-3.5 rounded-sm">
                <p class="text-xs font-bold text-sb-black uppercase tracking-wider">
                  Email Notification Timeline[cite: 1]
                </p>

                <!-- 1st Email -->
                <div class="flex items-start gap-3 border-t border-sb-gold/10 pt-3">
                  <span class="text-sb-gold text-xs font-bold mt-0.5 shrink-0">1st</span>
                  <div class="text-sm">
                    <p class="font-medium text-neutral-800">
                      "Payment to SB Floristry successful"[cite: 1]
                    </p>
                    <p class="text-xs text-neutral-500 mt-0.5 font-light">
                      Sent within 15 minutes of your immediate checkout payment[cite: 1].
                    </p>
                  </div>
                </div>

                <!-- 2nd Email -->
                <div class="flex items-start gap-3 border-t border-sb-gold/10 pt-3.5">
                  <span class="text-sb-gold text-xs font-bold mt-0.5 shrink-0">2nd</span>
                  <div class="text-sm">
                    <p class="font-medium text-neutral-800">
                      "You've set up a Direct Debit"[cite: 1]
                    </p>
                    <p class="text-xs text-neutral-500 mt-0.5 font-light">
                      Sent automatically within 1 hour of setup[cite: 1].
                    </p>
                  </div>
                </div>
                
                <!-- 3rd Email -->
                <div class="flex items-start gap-3 border-t border-sb-gold/10 pt-3.5">
                  <span class="text-sb-gold text-xs font-bold mt-0.5 shrink-0">3rd</span>
                  <div class="text-sm">
                    <p class="font-medium text-neutral-800">
                      "You've set up a Direct Debit subscription"[cite: 1]
                    </p>
                    <p class="text-xs text-neutral-500 mt-0.5 font-light">
                      Sent automatically within 1 hour of setup[cite: 1].
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </li>

          <!-- Step 2: First Delivery -->
          <li class="flex items-start gap-4">
            <span class="w-6 h-6 rounded-full bg-sb-cream text-sb-gold text-xs flex items-center justify-center font-semibold shrink-0 mt-0.5">
              2
            </span>
            <div class="w-full">
              <h4 class="font-bold text-sb-black text-xs uppercase tracking-wider mb-1.5">
                First Scheduled Delivery[cite: 1]
              </h4>
              <p class="text-sm text-neutral-600 leading-relaxed">
                We will curate your first design using the week's most premium seasonal imports and hand-deliver them beautifully packaged to your door[cite: 1]. Future ongoing subscription payments will continue to trigger a confirmation receipt within 15 minutes of the charge[cite: 1].
              </p>
            </div>
          </li>

          <!-- Step 3: Holiday/Subscription Flexibility -->
          <li class="flex items-start gap-4">
            <span class="w-6 h-6 rounded-full bg-sb-cream text-sb-gold text-xs flex items-center justify-center font-semibold shrink-0 mt-0.5">
              3
            </span>
            <div>
              <h4 class="font-bold text-sb-black text-xs uppercase tracking-wider mb-1.5">
                Complete Flexibility[cite: 1]
              </h4>
              <p class="text-sm text-neutral-600 leading-relaxed">
                Need to pause deliveries while you are on holiday[cite: 1]? Simply email Bilja 48 hours before your next scheduled cycle[cite: 1].
              </p>
            </div>
          </li>
        </ul>
      </div>

      <!-- Return Button to Main Gallery Layout -->
      <div class="mt-12">
        <a 
          href="/" 
          class="inline-block bg-sb-black hover:bg-neutral-800 text-white text-xs uppercase tracking-luxury px-8 py-4 rounded-none transition-colors duration-200"
        >
          Return To Gallery
        </a>
      </div>

    </div>
  </main>
</Layout>

<style>
  /* Local typography baseline configuration overrides if tracking-luxury is missing */
  .tracking-luxury {
    letter-spacing: 0.18em;
  }
  .bg-sb-cream {
    background-color: #F7F4EF;
  }
  .bg-sb-cream\/40 {
    background-color: rgba(247, 244, 239, 0.4);
  }
  .border-sb-gold\/20 {
    border-color: rgba(197, 160, 89, 0.2);
  }
  .border-sb-gold\/10 {
    border-color: rgba(197, 160, 89, 0.1);
  }
  .text-sb-gold {
    color: #C5A059;
  }
  .bg-sb-gold {
    background-color: #C5A059;
  }
  .text-sb-black {
    color: #1A1A1A;
  }
</style>
