---
import Layout from '../../layouts/Layout.astro';

// B2B Sympathy & Funeral Overflow landing page for SB Floristry
// Located at src/pages/corporate/funeral-overflow.astro
---

<Layout 
  title="B2B White-Label Funeral & Sympathy Floristry Overflow | SB Floristry"
  description="Anonymous premium overflow sympathy floristry for independent funeral directors in Romford, Brentwood, Gidea Park, and across RM & CM postcodes. Protect your chapel's capacity."
>
  <!-- Background styling layer -->
  <div class="bg-stone-50 text-stone-900 font-sans antialiased min-h-screen selection:bg-stone-900 selection:text-white">
    
    <!-- Editorial Top-Banner -->
    <div class="bg-stone-900 text-stone-100 text-xs tracking-[0.25em] uppercase py-3 px-4 text-center border-b border-stone-800">
      <span class="inline-flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
        Exclusive B2B Channel: Reserved For Registered Independent Funeral Directors
      </span>
    </div>

    <!-- MAIN HERO SECTION -->
    <header class="relative overflow-hidden py-16 lg:py-24 border-b border-stone-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          
          <!-- Editorial Copy Block -->
          <div class="lg:col-span-7 space-y-8">
            <nav class="text-stone-500 text-xs uppercase tracking-widest font-semibold">
              SB Floristry &mdash; B2B Logistics Division
            </nav>
            
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-light text-stone-900 leading-[1.15] tracking-tight">
              Trusted Overflow Capacity &amp; <span class="font-normal italic">White-Label</span> Sympathy Floral Design for Independent Funeral Directors
            </h1>
            
            <p class="text-stone-600 text-lg sm:text-xl leading-relaxed max-w-2xl font-light">
              A premium, completely anonymous trade partnership layer engineered to protect your operational capacity in Romford, Brentwood, and across the RM & CM postcodes when your primary suppliers hit volume ceilings.
            </p>

            <div class="pt-2 flex flex-col sm:flex-row gap-4">
              <a 
                href="#register-form" 
                class="inline-flex justify-center items-center px-8 py-4 border border-transparent text-sm font-medium tracking-wider uppercase text-white bg-stone-900 hover:bg-stone-800 transition-all duration-300 shadow-sm"
              >
                Register for Trade Priority Access
              </a>
              <a 
                href="#sos-dispatch" 
                class="inline-flex justify-center items-center px-8 py-4 border border-stone-300 text-sm font-medium tracking-wider uppercase text-stone-700 hover:text-stone-900 hover:border-stone-900 transition-all duration-300"
              >
                Activate 48-Hour Emergency SOS
              </a>
            </div>

            <!-- Fast stats row -->
            <div class="pt-8 border-t border-stone-200 grid grid-cols-3 gap-6">
              <div>
                <p class="text-2xl font-serif text-stone-900">0%</p>
                <p class="text-[10px] uppercase tracking-wider text-stone-500 mt-1">Retail Self-Promotion</p>
              </div>
              <div>
                <p class="text-2xl font-serif text-stone-900">Before 8:30</p>
                <p class="text-[10px] uppercase tracking-wider text-stone-500 mt-1">Guaranteed Delivery</p>
              </div>
              <div>
                <p class="text-2xl font-serif text-stone-900">100%</p>
                <p class="text-[10px] uppercase tracking-wider text-stone-500 mt-1">White-Label Discretion</p>
              </div>
            </div>
          </div>

          <!-- Hero Image Showcase with luxury framing -->
          <div class="lg:col-span-5 relative">
            <div class="absolute inset-0 border border-stone-300 translate-x-4 translate-y-4 -z-10"></div>
            <div class="border border-stone-900 p-2 bg-white shadow-xl">
              <div class="aspect-[4/5] relative overflow-hidden bg-stone-100">
                <img 
                  src="/images/collection-sympathy.jpg" 
                  alt="High-end white floral sympathy arrangement by SB Floristry" 
                  class="w-full h-full object-cover grayscale-[20%] hover:scale-105 transition-transform duration-700 ease-out"
                  onerror="this.src='/images/hero.jpg'; this.onerror=null;"
                />
                <div class="absolute inset-0 bg-stone-900/10 mix-blend-multiply"></div>
                <div class="absolute bottom-6 left-6 right-6 bg-stone-900/90 text-white p-5 backdrop-blur-sm border border-stone-800">
                  <p class="font-serif italic text-base mb-1">Uncompromising Sympathy Standards</p>
                  <p class="text-xs text-stone-400 font-light">Custom-molded structural tributes, casket blankets, and intricate standing floral displays.</p>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </header>

    <!-- SECTION: THE WHITE-LABEL DISCRETION PROTOCOL -->
    <section class="py-20 bg-stone-100 border-b border-stone-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
          <span class="text-xs font-semibold uppercase tracking-[0.2em] text-stone-500">Our Unfair Advantage</span>
          <h2 class="text-3xl sm:text-4xl font-serif font-light text-stone-900">
            The White-Label Discretion Protocol
          </h2>
          <div class="w-16 h-[1px] bg-stone-400 mx-auto my-6"></div>
          <p class="text-stone-600 font-light leading-relaxed">
            Unlike traditional retail florists who view your chapel as an opportunity to pass out care cards, collect private data, and capture your clients, we operate under a strict and ironclad silent operational covenant. Your branding remains completely intact; we remain completely invisible.
          </p>
        </div>

        <!-- Discretion Pillars Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          
          <!-- Pillar 1 -->
          <div class="bg-white p-8 border border-stone-200 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow duration-300">
            <div class="space-y-6">
              <div class="w-12 h-12 rounded-full bg-stone-50 flex items-center justify-center text-stone-800 border border-stone-100 font-serif text-lg font-light">
                01
              </div>
              <h3 class="text-xl font-serif text-stone-900">100% Unbranded Logistics</h3>
              <p class="text-stone-600 text-sm leading-relaxed font-light">
                All sympathy commissions are dispatched and delivered in unmarked prestige vehicles. Our structural transit boxes, water wells, and supporting wraps are entirely bare of logos, contact numbers, or brand markers.
              </p>
            </div>
            <div class="mt-8 pt-4 border-t border-stone-100 text-[11px] font-semibold tracking-wider text-stone-400 uppercase">
              Zero Visual footprint
            </div>
          </div>

          <!-- Pillar 2 -->
          <div class="bg-white p-8 border border-stone-200 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow duration-300">
            <div class="space-y-6">
              <div class="w-12 h-12 rounded-full bg-stone-50 flex items-center justify-center text-stone-800 border border-stone-100 font-serif text-lg font-light">
                02
              </div>
              <h3 class="text-xl font-serif text-stone-900">Zero Retail Cross-Promotion</h3>
              <p class="text-stone-600 text-sm leading-relaxed font-light">
                We guarantee that no corporate care cards, discount codes, or promotional tags will ever enter your chapel of rest. We attach only your funeral home's branded sympathy cards or leave them beautifully blank for your handwritten notes.
              </p>
            </div>
            <div class="mt-8 pt-4 border-t border-stone-100 text-[11px] font-semibold tracking-wider text-stone-400 uppercase">
              Your Brand is Front &amp; Center
            </div>
          </div>

          <!-- Pillar 3 -->
          <div class="bg-white p-8 border border-stone-200 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow duration-300">
            <div class="space-y-6">
              <div class="w-12 h-12 rounded-full bg-stone-50 flex items-center justify-center text-stone-800 border border-stone-100 font-serif text-lg font-light">
                03
              </div>
              <h3 class="text-xl font-serif text-stone-900">Professional House Decorum</h3>
              <p class="text-stone-600 text-sm leading-relaxed font-light">
                Our delivery technicians act as seamless extensions of your internal staff. We arrive strictly in professional black funeral-home attire, understand the delicate nature of chapel logistics, and maintain absolute, silent respect during drop-offs.
              </p>
            </div>
            <div class="mt-8 pt-4 border-t border-stone-100 text-[11px] font-semibold tracking-wider text-stone-400 uppercase">
              Flawless Chapel Protocol
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- SECTION: THE EMERGENCY "SOS" DISPATCH BYPASS -->
    <section id="sos-dispatch" class="py-16 bg-stone-900 text-stone-100 relative overflow-hidden">
      <!-- Muted decorative overlay -->
      <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:16px_16px]"></div>
      
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="border border-stone-800 bg-stone-950 p-8 sm:p-12 md:p-16 relative">
          
          <!-- Urgent Label -->
          <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-amber-500 text-stone-950 px-4 py-1 text-[10px] font-bold tracking-[0.2em] uppercase rounded-full">
            Direct Dispatch Bypass
          </div>

          <div class="text-center space-y-6">
            <h2 class="text-2xl sm:text-3xl font-serif font-light tracking-wide text-white">
              Short-Notice Emergency Capacity
            </h2>
            <p class="text-stone-300 max-w-3xl mx-auto font-light leading-relaxed text-sm sm:text-base">
              Has your primary floral supplier capped out, faced an unexpected delay, fell ill, or declined an incredibly complex family commission for an upcoming service within the next 48 hours?
            </p>
            
            <div class="w-20 h-[1px] bg-stone-800 mx-auto"></div>

            <p class="text-amber-500 text-xs sm:text-sm tracking-widest uppercase font-semibold">
              Bypassing normal dispatch &bull; Instant Operational Insurance
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-2xl mx-auto pt-4">
              <!-- Call Dispatch -->
              <a 
                href="tel:+447700900077" 
                class="flex items-center justify-center gap-3 px-6 py-4 bg-stone-900 hover:bg-stone-800 border border-stone-800 text-white rounded-none transition-all duration-300"
              >
                <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                <div class="text-left">
                  <span class="block text-[9px] uppercase tracking-wider text-stone-400">Direct Hotline Dial</span>
                  <span class="font-mono text-sm tracking-wide">07700 900077</span>
                </div>
              </a>

              <!-- WhatsApp Dispatch -->
              <a 
                href="https://wa.me/447700900077?text=Priority%20B2B%20Emergency%20Sympathy%20Request%20-%20SB%20Floristry" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="flex items-center justify-center gap-3 px-6 py-4 bg-emerald-950/60 hover:bg-emerald-950 border border-emerald-900 text-white rounded-none transition-all duration-300"
              >
                <svg class="w-5 h-5 text-emerald-400" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.458 5.704 1.459h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                <div class="text-left">
                  <span class="block text-[9px] uppercase tracking-wider text-emerald-400">Secure Direct Message</span>
                  <span class="font-mono text-sm tracking-wide">WhatsApp Dispatch</span>
                </div>
              </a>
            </div>

            <p class="text-stone-500 text-[10px] uppercase tracking-[0.15em] max-w-md mx-auto pt-2">
              Note: Urgent priority line is guarded strictly for chapels of rest and funeral house managers.
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- SECTION: GEOGRAPHIC PRIORITY RADIUS UTILITY & POSTCODE CHECKER -->
    <section class="py-20 bg-white border-b border-stone-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          
          <!-- Radius Details -->
          <div class="lg:col-span-7 space-y-6">
            <span class="text-xs font-semibold uppercase tracking-[0.2em] text-stone-500">Local Logistics Boundary</span>
            <h2 class="text-3xl font-serif font-light text-stone-900 leading-tight">
              Guaranteed Priority Radius
            </h2>
            <p class="text-stone-600 font-light leading-relaxed">
              Timely presentation is vital for funeral decorum. Our operations are localized tightly to guarantee pre-registered partners early-morning delivery before 8:30 AM.
            </p>
            
            <div class="p-6 bg-stone-50 border border-stone-200">
              <h4 class="font-serif text-stone-900 mb-2">Our Dedicated Postcode Footprint</h4>
              <p class="text-stone-600 text-sm font-light mb-4">
                We maintain active early morning routes inside the following key areas across the RM & CM postal code matrix:
              </p>
              
              <!-- Postcodes Tokens -->
              <div class="flex flex-wrap gap-2">
                {["RM1", "RM2", "RM3", "RM4", "RM5", "RM7", "RM11", "RM12", "CM13", "CM14", "CM15"].map((postcode) => (
                  <span class="px-3 py-1 bg-white border border-stone-200 font-mono text-xs text-stone-800 tracking-wider font-semibold">
                    {postcode}
                  </span>
                ))}
              </div>
            </div>

            <p class="text-xs text-stone-500 italic">
              * Delivery at chapel premises or church house is coordinated and tracked, providing you with high-resolution delivery confirmations automatically.
            </p>
          </div>

          <!-- Interactive Postcode Checker Utility Card -->
          <div class="lg:col-span-5">
            <div class="bg-stone-50 border border-stone-200 p-8 shadow-sm">
              <h3 class="text-xl font-serif text-stone-900 mb-4">Instant Radius Checker</h3>
              <p class="text-stone-600 text-xs font-light mb-6">
                Enter your chapel, office, or delivery location postcode below to instantly verify early-morning coverage.
              </p>

              <div class="space-y-4">
                <div>
                  <label for="postcode-input" class="sr-only">Enter Postcode</label>
                  <div class="relative">
                    <input 
                      type="text" 
                      id="postcode-input" 
                      placeholder="e.g. RM11" 
                      class="w-full px-4 py-3 bg-white border border-stone-300 text-stone-900 uppercase tracking-widest font-mono text-sm placeholder:text-stone-400 focus:outline-none focus:border-stone-900 focus:ring-1 focus:ring-stone-900 rounded-none"
                    />
                    <button 
                      type="button" 
                      id="check-btn" 
                      class="absolute right-2 top-1/2 -translate-y-1/2 px-4 py-1.5 bg-stone-900 text-white text-[10px] tracking-widest uppercase font-semibold hover:bg-stone-800 transition-colors"
                    >
                      Check
                    </button>
                  </div>
                </div>

                <!-- Custom feedback element -->
                <div id="checker-feedback" class="hidden p-4 text-xs font-light tracking-wide leading-relaxed border"></div>
              </div>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- SECTION: DIGITAL PORTFOLIO TEASER GRID -->
    <section class="py-20 bg-stone-100 border-b border-stone-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
          <span class="text-xs font-semibold uppercase tracking-[0.2em] text-stone-500">Technical Craftsmanship</span>
          <h2 class="text-3xl font-serif font-light text-stone-900">
            Portfolio Capabilities &amp; Form Execution
          </h2>
          <p class="text-stone-600 text-sm font-light max-w-xl mx-auto">
            From classic white tribute scripts to massive complex architectural sprays, Biljana and the SB Floristry design team build floral work with outstanding structural integrity.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          
          <!-- Card 1 -->
          <div class="group bg-white border border-stone-200 overflow-hidden shadow-sm hover:shadow-md transition-all duration-300">
            <div class="aspect-[3/2] overflow-hidden bg-stone-100 relative">
              <img 
                src="/images/collection-sympathy.jpg" 
                alt="Signature Coffin Spray" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                onerror="this.src='/images/gallery-1.jpg'; this.onerror=null;"
              />
              <span class="absolute top-4 left-4 bg-white text-stone-900 font-mono text-[9px] uppercase tracking-widest px-3 py-1 font-semibold border border-stone-200">
                Category 01
              </span>
            </div>
            <div class="p-6 space-y-3">
              <h3 class="text-lg font-serif text-stone-900 group-hover:text-stone-700 transition-colors">The Signature Coffin Spray</h3>
              <p class="text-stone-600 text-xs leading-relaxed font-light">
                Constructed with premium avalanche white roses, architectural lilies, and premium eucalyptus greens. Anchored securely on water-fed, high-density bio-foam grids that protect polished casket wood.
              </p>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="group bg-white border border-stone-200 overflow-hidden shadow-sm hover:shadow-md transition-all duration-300">
            <div class="aspect-[3/2] overflow-hidden bg-stone-100 relative">
              <img 
                src="/images/gallery-3.jpg" 
                alt="Standing Sympathy Spray" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                onerror="this.src='/images/gallery-2.jpg'; this.onerror=null;"
              />
              <span class="absolute top-4 left-4 bg-white text-stone-900 font-mono text-[9px] uppercase tracking-widest px-3 py-1 font-semibold border border-stone-200">
                Category 02
              </span>
            </div>
            <div class="p-6 space-y-3">
              <h3 class="text-lg font-serif text-stone-900 group-hover:text-stone-700 transition-colors">Standing Easel Installations</h3>
              <p class="text-stone-600 text-xs leading-relaxed font-light">
                Cascading architectural tributes crafted for chapel backdrop placements, church altars, or memorial service gateways. Fully configured for extreme weight stability on solid ash wooden easel legs.
              </p>
            </div>
          </div>

          <!-- Card 3 -->
          <div class="group bg-white border border-stone-200 overflow-hidden shadow-sm hover:shadow-md transition-all duration-300">
            <div class="aspect-[3/2] overflow-hidden bg-stone-100 relative">
              <img 
                src="/images/gallery-5.jpg" 
                alt="Custom Sympathy Letters" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                onerror="this.src='/images/gallery-4.jpg'; this.onerror=null;"
              />
              <span class="absolute top-4 left-4 bg-white text-stone-900 font-mono text-[9px] uppercase tracking-widest px-3 py-1 font-semibold border border-stone-200">
                Category 03
              </span>
            </div>
            <div class="p-6 space-y-3">
              <h3 class="text-lg font-serif text-stone-900 group-hover:text-stone-700 transition-colors">Custom Outlines &amp; Lettering</h3>
              <p class="text-stone-600 text-xs leading-relaxed font-light">
                Impeccably trimmed, high-density foam framing packed tight with premium mass blooms. Built with exact spacing for personalized text block names, insignia, and custom organizational crests.
              </p>
            </div>
          </div>

        </div>

        <div class="mt-12 text-center">
          <p class="text-xs text-stone-500">
            Register your trade account below to receive our exclusive B2B floral catalogue and full bespoke price list.
          </p>
        </div>

      </div>
    </section>

    <!-- SECTION: B2B PRIORITY ACCOUNT ACQUISITION FORM -->
    <section id="register-form" class="py-20 bg-stone-900 text-stone-100 relative">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="border border-stone-800 bg-stone-950 p-8 sm:p-12 shadow-2xl relative">
          
          <div class="text-center space-y-4 mb-10">
            <span class="text-xs font-semibold uppercase tracking-[0.25em] text-amber-500">Priority B2B Access</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-light text-white">
              Trade Account Priority Registration &amp; Dossier Request
            </h2>
            <p class="text-stone-400 text-sm font-light max-w-md mx-auto">
              Protect your chapel capacity. Submit your parameters below to lock in automatic 8:30 AM delivery privileges and receive our physical B2B catalog.
            </p>
            <div class="w-12 h-[1px] bg-stone-800 mx-auto pt-2"></div>
          </div>

          <!-- The Registration Form -->
          <form id="trade-registration" class="space-y-6">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              
              <!-- Director Name -->
              <div>
                <label for="director_name" class="block text-xs uppercase tracking-widest text-stone-400 mb-2 font-medium">
                  Director Name <span class="text-amber-500">*</span>
                </label>
                <input 
                  type="text" 
                  name="director_name" 
                  id="director_name" 
                  required
                  placeholder="e.g. Thomas Harrison" 
                  class="w-full px-4 py-3 bg-stone-900 border border-stone-800 text-stone-100 placeholder:text-stone-600 text-sm focus:outline-none focus:border-stone-500 focus:ring-1 focus:ring-stone-500 rounded-none transition-colors"
                />
              </div>

              <!-- Funeral Home Name -->
              <div>
                <label for="funeral_home" class="block text-xs uppercase tracking-widest text-stone-400 mb-2 font-medium">
                  Funeral Home Name <span class="text-amber-500">*</span>
                </label>
                <input 
                  type="text" 
                  name="funeral_home" 
                  id="funeral_home" 
                  required
                  placeholder="e.g. Harrison &amp; Sons Funeral Directors" 
                  class="w-full px-4 py-3 bg-stone-900 border border-stone-800 text-stone-100 placeholder:text-stone-600 text-sm focus:outline-none focus:border-stone-500 focus:ring-1 focus:ring-stone-500 rounded-none transition-colors"
                />
              </div>

            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              
              <!-- Corporate Postcode -->
              <div>
                <label for="postcode" class="block text-xs uppercase tracking-widest text-stone-400 mb-2 font-medium">
                  Corporate Postcode <span class="text-amber-500">*</span>
                </label>
                <input 
                  type="text" 
                  name="postcode" 
                  id="postcode" 
                  required
                  placeholder="e.g. RM11 3AB" 
                  class="w-full px-4 py-3 bg-stone-900 border border-stone-800 text-stone-100 placeholder:text-stone-600 text-sm uppercase tracking-wider focus:outline-none focus:border-stone-500 focus:ring-1 focus:ring-stone-500 rounded-none transition-colors"
                />
              </div>

              <!-- Direct Phone / Mobile -->
              <div>
                <label for="phone" class="block text-xs uppercase tracking-widest text-stone-400 mb-2 font-medium">
                  Direct Mobile / Phone <span class="text-amber-500">*</span>
                </label>
                <input 
                  type="tel" 
                  name="phone" 
                  id="phone" 
                  required
                  placeholder="e.g. 07700 900077" 
                  class="w-full px-4 py-3 bg-stone-900 border border-stone-800 text-stone-100 placeholder:text-stone-600 text-sm focus:outline-none focus:border-stone-500 focus:ring-1 focus:ring-stone-500 rounded-none transition-colors"
                />
              </div>

            </div>

            <!-- Corporate Email -->
            <div>
              <label for="email" class="block text-xs uppercase tracking-widest text-stone-400 mb-2 font-medium">
                Corporate Email Address <span class="text-amber-500">*</span>
              </label>
              <input 
                type="email" 
                name="email" 
                id="email" 
                required
                placeholder="e.g. contact@harrisonfunerals.co.uk" 
                class="w-full px-4 py-3 bg-stone-900 border border-stone-800 text-stone-100 placeholder:text-stone-600 text-sm focus:outline-none focus:border-stone-500 focus:ring-1 focus:ring-stone-500 rounded-none transition-colors"
              />
            </div>

            <!-- Overflow Needs dropdown -->
            <div>
              <label for="needs" class="block text-xs uppercase tracking-widest text-stone-400 mb-2 font-medium">
                Estimated Monthly Overflow Needs <span class="text-amber-500">*</span>
              </label>
              <div class="relative">
                <select 
                  name="needs" 
                  id="needs" 
                  required
                  class="w-full px-4 py-3 bg-stone-900 border border-stone-800 text-stone-100 text-sm focus:outline-none focus:border-stone-500 focus:ring-1 focus:ring-stone-500 rounded-none appearance-none cursor-pointer transition-colors"
                >
                  <option value="" disabled selected class="text-stone-600">Select estimated frequency...</option>
                  <option value="Emergency Only" class="text-stone-100">Emergency / Holiday Backup Only</option>
                  <option value="Seasonal Peak" class="text-stone-100">Seasonal Peak Support (Mothering Sunday, Christmas, Peaks)</option>
                  <option value="Frequent Overflow" class="text-stone-100">Frequent Capacity Support (Consistent Overflow Partner)</option>
                </select>
                <!-- Custom chevron indicator -->
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-stone-400">
                  <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                    <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/>
                  </svg>
                </div>
              </div>
            </div>

            <!-- Disclaimer protocol info -->
            <p class="text-[10px] text-stone-500 leading-relaxed font-light">
              By submitting this dossier request, you authorize SB Floristry to record these operational parameters under our strict B2B privacy covenant. We will never share your information, and all communications remain confidential.
            </p>

            <!-- Submit Button -->
            <button 
              type="submit" 
              class="w-full py-4 px-6 bg-stone-100 hover:bg-white text-stone-950 text-xs font-semibold tracking-[0.2em] uppercase transition-all duration-300 rounded-none shadow-md flex items-center justify-center gap-2"
            >
              Secure Trade Priority Access &amp; Request Dossier
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 5l7 7-7 7"/>
              </svg>
            </button>

          </form>

          <!-- Custom Inline Success Modal (Client Side) -->
          <div id="form-success" class="hidden absolute inset-0 bg-stone-950 p-8 sm:p-12 flex flex-col items-center justify-center text-center space-y-6">
            <div class="w-16 h-16 rounded-full bg-stone-900 border border-stone-800 flex items-center justify-center text-amber-500">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <h3 class="text-2xl font-serif text-white">Priority Registration Pending</h3>
            <p class="text-stone-300 text-sm font-light max-w-md leading-relaxed">
              Thank you, Director <span id="success-director-name" class="font-normal text-white"></span>. Your request on behalf of <span id="success-funeral-home" class="font-normal text-white"></span> has been captured.
            </p>
            <p class="text-stone-400 text-xs font-light max-w-sm leading-relaxed">
              Biljana will contact you at your direct mobile line (<span id="success-phone" class="font-mono text-stone-200"></span>) within 12 business hours to confirm your priority 8:30 AM delivery slot and dispatch your printed B2B Trade Dossier.
            </p>
            <div class="w-16 h-[1px] bg-stone-800"></div>
            <button 
              id="reset-form-btn"
              type="button" 
              class="text-xs text-stone-500 uppercase tracking-widest border-b border-stone-800 hover:text-stone-300 hover:border-stone-500 transition-colors py-1"
            >
              Back to Form
            </button>
          </div>

        </div>

      </div>
    </section>

  </div>

  <!-- Interactive Client-side Script Block for Postcode validation & form processing -->
  <script>
    // List of target postal sectors/outcodes guaranteed under early-morning delivery
    const GUARANTEED_POSTCODES = ["RM1", "RM2", "RM3", "RM4", "RM5", "RM7", "RM11", "RM12", "CM13", "CM14", "CM15"];

    document.addEventListener('DOMContentLoaded', () => {
      
      // 1. Postcode Checker Logic
      const inputEl = document.getElementById('postcode-input');
      const checkBtn = document.getElementById('check-btn');
      const feedbackEl = document.getElementById('checker-feedback');

      if (inputEl && checkBtn && feedbackEl) {
        checkBtn.addEventListener('click', () => {
          const rawVal = inputEl.value.trim().toUpperCase();
          
          if (!rawVal) {
            feedbackEl.className = "p-4 text-xs font-light tracking-wide leading-relaxed border bg-amber-50 border-amber-200 text-amber-900";
            feedbackEl.innerHTML = "<strong>Attention Required:</strong> Please enter a postcode to check our logistical radius.";
            feedbackEl.classList.remove('hidden');
            return;
          }

          // Extract outer code or sector part (e.g. "RM11 3AB" -> "RM11", "RM1" -> "RM1")
          const outcodeMatch = rawVal.match(/^[A-Z]{1,2}[0-9]{1,2}/);
          const outcode = outcodeMatch ? outcodeMatch[0] : rawVal;

          const isGuaranteed = GUARANTEED_POSTCODES.includes(outcode);

          if (isGuaranteed) {
            feedbackEl.className = "p-4 text-xs font-light tracking-wide leading-relaxed border bg-stone-900 border-stone-800 text-stone-100";
            feedbackEl.innerHTML = `
              <div class="flex items-start gap-3">
                <span class="text-emerald-400 text-sm">✓</span>
                <div>
                  <strong class="text-white">Logistics Verified:</strong> Area <strong>${outcode}</strong> is within our guaranteed early morning priority delivery circle. Your pre-registered orders are guaranteed before 8:30 AM.
                </div>
              </div>
            `;
          } else {
            feedbackEl.className = "p-4 text-xs font-light tracking-wide leading-relaxed border bg-stone-50 border-stone-200 text-stone-700";
            feedbackEl.innerHTML = `
              <div class="flex items-start gap-3">
                <span class="text-amber-500 text-sm">✦</span>
                <div>
                  <strong class="text-stone-900">Priority Review Required:</strong> Area <strong>${outcode}</strong> lies slightly outside our automatic 8:30 AM delivery grid. We can still dispatch to this postcode but need to manually clear the morning schedule. Please register your account for customized arrangements.
                </div>
              </div>
            `;
          }
          feedbackEl.classList.remove('hidden');
        });

        // Trigger check on Enter press
        inputEl.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            checkBtn.click();
          }
        });
      }

      // 2. Custom Success Overlay on Form Submit
      const registrationForm = document.getElementById('trade-registration');
      const successModal = document.getElementById('form-success');
      const resetBtn = document.getElementById('reset-form-btn');

      if (registrationForm && successModal) {
        registrationForm.addEventListener('submit', (e) => {
          e.preventDefault();

          // Pull values for customized success feedback
          const dName = document.getElementById('director_name').value;
          const fHome = document.getElementById('funeral_home').value;
          const phoneNum = document.getElementById('phone').value;

          document.getElementById('success-director-name').textContent = dName;
          document.getElementById('success-funeral-home').textContent = fHome;
          document.getElementById('success-phone').textContent = phoneNum;

          // Swap UI state with animation support
          successModal.classList.remove('hidden');
          successModal.classList.add('flex', 'animate-[fadeIn_0.4s_ease-out]');
        });
      }

      if (resetBtn && successModal && registrationForm) {
        resetBtn.addEventListener('click', () => {
          registrationForm.reset();
          successModal.classList.add('hidden');
          successModal.classList.remove('flex');
        });
      }

    });
  </script>

</Layout>
