---
import Layout from '../../layouts/Layout.astro';
import { getProductByHandle, getProducts } from '../../utils/shopify';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({
    params: { handle: product.handle },
  }));
}

const { handle } = Astro.params;
const product = await getProductByHandle(handle);

if (!product) {
  return Astro.redirect('/404');
}

// Format price helper
const formatPrice = (amount) => {
  return new Intl.NumberFormat('en-GB', {
    style: 'currency',
    currency: product.currency || 'GBP',
  }).format(parseFloat(amount));
};
---

<Layout title={`${product.title} | SB Floristry`}>
  <div class="bg-white">
    <div class="mx-auto max-w-2xl px-4 py-16 sm:px-6 sm:py-24 lg:max-w-7xl lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:items-start lg:gap-x-8">
        <!-- Image gallery -->
        <div class="flex flex-col-reverse">
          <!-- Image selector -->
          {product.images && product.images.length > 1 && (
            <div class="mx-auto mt-6 hidden w-full max-w-2xl sm:block">
              <div class="grid grid-cols-4 gap-6" aria-label="Images">
                {product.images.map((image, index) => (
                  <button
                    class="relative flex h-24 cursor-pointer items-center justify-center rounded-md bg-white text-sm font-medium uppercase text-gray-900 hover:bg-gray-50 focus:outline-none focus:ring focus:ring-opacity-50 focus:ring-offset-4 thumbnail-btn"
                    data-index={index}
                  >
                    <span class="sr-only">View image {index + 1}</span>
                    <span class="absolute inset-0 overflow-hidden rounded-md">
                      <img src={image.url} alt={image.altText} class="h-full w-full object-cover object-center" />
                    </span>
                  </button>
                ))}
              </div>
            </div>
          )}

          <div class="aspect-h-1 aspect-w-1 w-full">
            <div id="main-image-container" class="h-[500px] w-full overflow-hidden rounded-lg bg-gray-100">
              <img
                id="main-product-image"
                src={product.images && product.images[0] ? product.images[0].url : '/images/hero.jpg'}
                alt={product.images && product.images[0] ? product.images[0].altText : product.title}
                class="h-full w-full object-cover object-center sm:rounded-lg"
              />
            </div>
          </div>
        </div>

        <!-- Product info -->
        <div class="mt-10 px-4 sm:mt-16 sm:px-0 lg:mt-0">
          <h1 class="text-3xl font-bold tracking-tight text-accent font-serif">{product.title}</h1>

          <div class="mt-3">
            <h2 class="sr-only">Product information</h2>
            <p id="product-price" class="text-3xl tracking-tight text-gray-900">{formatPrice(product.price)}</p>
          </div>

          <div class="mt-6">
            <h3 class="sr-only">Description</h3>
            <div class="space-y-6 text-base text-gray-700 whitespace-pre-line">
              {product.description}
            </div>
          </div>

          <!-- Product Options / Size Selection -->
          {product.variants && product.variants.length > 1 && product.variants[0].title !== 'Default Title' && (
            <div class="mt-8 border-t border-gray-200 pt-8">
              <h3 class="text-sm font-semibold text-gray-900 font-serif">Select Bouquet Size</h3>
              <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-3">
                {product.variants.map((v, index) => (
                  <button
                    type="button"
                    class={`variant-option-btn relative flex cursor-pointer rounded-lg border p-4 shadow-sm focus:outline-none transition-all duration-200 ${
                      index === 0
                        ? 'border-primary ring-2 ring-primary bg-primary/5'
                        : 'border-gray-200 hover:border-gray-300 bg-white'
                    }`}
                    data-variant-id={v.id}
                    data-price={v.price}
                    data-title={v.title}
                  >
                    <span class="flex flex-1">
                      <span class="flex flex-col text-left">
                        <span class="block text-sm font-medium text-gray-900">{v.title}</span>
                        <span class="mt-1 flex items-center text-sm text-gray-500 font-semibold">
                          {formatPrice(v.price)}
                        </span>
                      </span>
                    </span>
                  </button>
                ))}
              </div>
            </div>
          )}

          <div class="mt-8 border-t border-gray-200 pt-8">
            <div class="flex flex-col space-y-4">
              <button
                id="add-to-cart-btn"
                data-product-id={product.id}
                data-variant-id={product.variantId}
                data-title={product.title}
                data-price={product.price}
                data-image={product.images && product.images[0] ? product.images[0].url : '/images/hero.jpg'}
                class="flex max-w-xs flex-1 items-center justify-center rounded-md border border-transparent bg-primary px-8 py-3 text-base font-medium text-white hover:bg-primary-dark focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-gray-50 sm:w-full transition-colors duration-200"
              >
                Add to Basket
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ product }}>
  // Wrapping in an IIFE to prevent variable declaration conflicts across views
  (function() {
    const mainImage = document.getElementById('main-product-image');
    const thumbnails = document.querySelectorAll('.thumbnail-btn');

    thumbnails.forEach(btn => {
      btn.addEventListener('click', () => {
        const index = parseInt(btn.dataset.index);
        const newImage = product.images[index];
        if (mainImage && newImage) {
          mainImage.src = newImage.url;
          mainImage.alt = newImage.altText;
        }
      });
    });

    let selectedVariant = product.variants && product.variants.length > 0
      ? product.variants[0]
      : { id: product.variantId, title: 'Default Title', price: product.price };

    const variantButtons = document.querySelectorAll('.variant-option-btn');
    const priceDisplay = document.getElementById('product-price');
    const addToCartBtn = document.getElementById('add-to-cart-btn');

    variantButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const variantId = btn.getAttribute('data-variant-id');
        const price = parseFloat(btn.getAttribute('data-price') || '0');
        const title = btn.getAttribute('data-title');

        selectedVariant = {
          id: variantId,
          title: title,
          price: price
        };

        variantButtons.forEach(otherBtn => {
          if (otherBtn === btn) {
            otherBtn.classList.remove('border-gray-200', 'hover:border-gray-300', 'bg-white');
            otherBtn.classList.add('border-primary', 'ring-2', 'ring-primary', 'bg-primary/5');
          } else {
            otherBtn.classList.remove('border-primary', 'ring-2', 'ring-primary', 'bg-primary/5');
            otherBtn.classList.add('border-gray-200', 'hover:border-gray-300', 'bg-white');
          }
        });

        if (priceDisplay) {
          const formatter = new Intl.NumberFormat('en-GB', {
            style: 'currency',
            currency: product.currency || 'GBP',
          });
          priceDisplay.textContent = formatter.format(price);
        }
      });
    });

    if (addToCartBtn) {
      addToCartBtn.addEventListener('click', () => {
        const item = {
          id: product.id,
          variantId: selectedVariant.id,
          variantTitle: selectedVariant.title,
          title: product.title,
          price: selectedVariant.price,
          image: product.images && product.images[0] ? product.images[0].url : '/images/hero.jpg',
          quantity: 1
        };

        const event = new CustomEvent('add-to-cart', { detail: item });
        window.dispatchEvent(event);
      });
    }
  })();
</script>
