---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialHero from '../components/editorial/EditorialHero.astro';
import PressStrip from '../components/editorial/PressStrip.astro';
import Chapter from '../components/editorial/Chapter.astro';
import ImageText from '../components/editorial/ImageText.astro';
import PortfolioGrid from '../components/portfolio/PortfolioGrid.astro';
import PullQuote from '../components/editorial/PullQuote.astro';
import InvestmentNote from '../components/editorial/InvestmentNote.astro';
import EnquireCTA from '../components/editorial/EnquireCTA.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('portfolio');
const featuredProjects = allProjects
  .filter(p => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout
  title="Bespoke Luxury Florist London & Essex | SB Floristry"
  description="SB Floristry: Architectural botanical installations, quiet luxury weddings, and bespoke floral commissions across London, Essex, and private estates."
  canonical="https://www.sbfloristry.co.uk/"
>
  <!-- Hero Section -->
  <EditorialHero
    variant="full-bleed"
    eyebrow="Atelier of Bespoke Floristry • London & Essex"
    title="Architectural Floristry & Quiet Luxury Celebrations"
    subtitle="Sensorial botanical installations, private estate weddings, and bespoke floral design curated by studio founders."
    image="/images/hero.jpg"
    imageAlt="SB Floristry Luxury Architectural Floral Installation"
    caption="The Orangery Estate • High Summer Commission • SB Floristry"
    primaryCtaText="Commission an Enquiry →"
    primaryCtaHref="/enquire/"
    secondaryCtaText="Explore Portfolio"
    secondaryCtaHref="/portfolio/"
  />

  <!-- Press & Editorial Mentions -->
  <PressStrip />

  <!-- The Disciplines Overview Chapter -->
  <section class="py-16 md:py-24 bg-obsidian text-cream">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <Chapter
        number="I"
        eyebrow="The Practice"
        title="Bespoke Botanical Disciplines"
        subtitle="Every commission is founder-led, intentionally proportioned to its architectural setting, and executed with rare British & European seasonal stems."
      />
    </div>
  </section>

  <!-- Editorial Asymmetric Pillar Splits -->
  <div class="space-y-4 md:space-y-8 bg-noir border-y border-white/10">
    
    <!-- Weddings Split (7/5) -->
    <ImageText
      split="7-5"
      image="/images/collection-weddings.jpg"
      imageAlt="Luxury Wedding Floral Archway"
      caption="Hedsor House • Buckinghamshire • Summer"
      chapterNumber="01"
      eyebrow="Weddings & Private Estates"
      title="Estate Weddings & Bridal Architecture"
      lead="Uncompromising botanical atmospheres conceived in harmony with historic venues and open parklands."
      text="From towering aisle monoliths and wild botanical ceremony arches to sensory candlelight tablescapes, our founders craft an immersive aesthetic world tailored specifically to your love story."
      ctaText="Explore Wedding Services →"
      ctaHref="/weddings/"
    />

    <!-- Events Split (5/7 Reversed) -->
    <ImageText
      split="5-7"
      reversed={true}
      image="/images/gallery-2.jpg"
      imageAlt="Private Gala Floral Tablescape"
      caption="Private Members Club • Mayfair W1 • Autumn"
      chapterNumber="02"
      eyebrow="Galas & Dinners"
      title="Private Galas & Brand Experiences"
      lead="Atmospheric dining environments and statement architectural centerpieces for unforgettable evenings."
      text="We collaborate directly with luxury houses, creative directors, and private hosts to deliver high-contrast floral drama that frames the evening without obstructing conversation."
      ctaText="Discover Event Design →"
      ctaHref="/events/"
    />

    <!-- Stem Bar Split (7/5) -->
    <ImageText
      split="7-5"
      image="/images/gallery-1.jpg"
      imageAlt="Botanical Stem Bar Experience"
      caption="Private Country Estate • Essex • Spring"
      chapterNumber="03"
      eyebrow="Interactive Experience"
      title="The Living Stem Bar"
      lead="A sommelier-style flower activation transforming floral favors into an unforgettable celebratory ritual."
      text="Invited guests curate their own bespoke floral arrangements from artisan brass vessels under the guidance of our master florists, bound in raw silk ribbon and hot wax seals."
      ctaText="Discover The Stem Bar →"
      ctaHref="/stem-bar/"
    />

    <!-- Sympathy Split (5/7 Reversed) -->
    <ImageText
      split="5-7"
      reversed={true}
      image="/images/collection-sympathy.jpg"
      imageAlt="Sympathy and Memorial Casket Spray"
      caption="Private Chapel • Brentwood • Winter"
      chapterNumber="04"
      eyebrow="Memorial Tributes"
      title="Quiet Solace & Bespoke Memorials"
      lead="Dignified, natural tributes crafted without foam or plastic, reflecting the true essence of a life."
      text="We handle every detail personally—liaising directly with funeral directors across London and Essex to ensure seamless, respectful delivery to church, chapel, or crematorium."
      ctaText="View Sympathy Tributes →"
      ctaHref="/sympathy/"
    />

  </div>

  <!-- Featured Works Showcase -->
  <section class="py-24 md:py-36 bg-obsidian text-cream">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <Chapter
        number="II"
        eyebrow="Selected Works"
        title="Curated Case Studies"
        subtitle="A closer look inside recent estate weddings, gala installations, and architectural commissions."
      />

      <div class="mt-16">
        <PortfolioGrid
          projects={featuredProjects}
          columns={3}
        />
      </div>

      <div class="text-center mt-14">
        <a href="/portfolio/" class="btn-outline-luxury">
          View Complete Archive (6 Projects) →
        </a>
      </div>
    </div>
  </section>

  <!-- Editorial Pull Quote -->
  <PullQuote
    quote="SB Floristry operates at the intersection of classical sculpture and organic wilderness. An absolute triumph of modern floral architecture."
    attribution="The Wedding Edition"
    role="Editorial Review"
    publication="London Luxury Guide"
  />

  <!-- Investment Transparency Note -->
  <InvestmentNote
    startingFrom="£3,500"
    service="Wedding & Private Estate Commissions"
    title="Curated Season Allocations"
    note="To preserve absolute creative integrity and founder-led execution on every project, our studio accepts a strictly capped allocation of commissions each season."
    inclusions={[
      "Founder-directed site survey & botanical master plan",
      "Ethically cultivated English garden roses & rare European blooms",
      "Custom vessel sourcing, staging, candlelight & installation",
      "Full post-event collection, white-glove teardown & floral repurposing"
    ]}
  />

  <!-- Shared Closing CTA -->
  <EnquireCTA
    eyebrow="The Dialogue"
    title="Begin Your Commission"
    subtitle="Every installation begins with a private conversation. Share your event date, venue, or vision with our studio founders."
  />
</BaseLayout>
